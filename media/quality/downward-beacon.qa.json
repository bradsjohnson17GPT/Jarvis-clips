  "caption_groups": [
    {
      "start": 0.2,
      "end": 0.98,
      "text": "Our town had"
    },
    {
      "start": 0.98,
      "end": 1.3,
      "text": "a lighthouse."
    },
    {
      "start": 2.19,
      "end": 2.55,
      "text": "But there was"
    },
    {
      "start": 2.55,
      "end": 3.19,
      "text": "no ocean."
    },
    {
      "start": 4.41,
      "end": 4.93,
      "text": "Every night,"
    },
    {
      "start": 5.17,
      "end": 5.49,
      "text": "I lit it"
    },
    {
      "start": 5.49,
      "end": 5.81,
      "text": "anyway."
    },
    {
      "start": 7.14,
      "end": 7.68,
      "text": "Then a paper"
    },
    {
      "start": 7.68,
      "end": 8.78,
      "text": "boat landed beside"
    },
    {
      "start": 8.78,
      "end": 9.1,
      "text": "me."
    },
    {
      "start": 10.065,
      "end": 10.425,
      "text": "There was a"
    },
    {
      "start": 10.425,
      "end": 11.165,
      "text": "message inside."
    },
    {
      "start": 12.54,
      "end": 13.08,
      "text": "Turn the beam"
    },
    {
      "start": 13.08,
      "end": 13.4,
      "text": "down."
    },
    {
      "start": 13.96,
      "end": 14.78,
      "text": "So I did."
    },
    {
      "start": 15.97,
      "end": 16.99,
      "text": "The clouds opened."
    },
    {
      "start": 17.9,
      "end": 19.18,
      "text": "And far below..."
    },
    {
      "start": 20.015,
      "end": 20.895,
      "text": "another lighthouse"
    },
    {
      "start": 20.895,
      "end": 21.575,
      "text": "answered."
    },
    {
      "start": 22.995,
      "end": 23.535,
      "text": "We weren't alone."
    },
    {
      "start": 24.46,
      "end": 25.0,
      "text": "We'd just been"
    },
    {
      "start": 25.0,
      "end": 25.62,
      "text": "looking the wrong"
    },
    {
      "start": 25.62,
      "end": 25.98,
      "text": "way."
